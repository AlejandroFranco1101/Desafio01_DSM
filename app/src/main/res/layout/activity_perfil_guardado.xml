<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/perfilGuardadoRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/profile_background"
    android:fillViewport="true"
    tools:context=".PerfilGuardadoActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvSavedTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/profile_saved_title"
            android:textColor="@color/profile_text"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSavedMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/profile_saved_message"
            android:textColor="@color/profile_secondary_text"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/summary_full_name_label"
                android:textColor="@color/profile_secondary_text"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvSummaryFullName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/profile_text"
                android:textSize="18sp"
                tools:text="Ana Martinez" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/summary_email_label"
                android:textColor="@color/profile_secondary_text"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvSummaryEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/profile_text"
                android:textSize="18sp"
                tools:text="ana@email.com" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/summary_phone_label"
                android:textColor="@color/profile_secondary_text"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvSummaryPhone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/profile_text"
                android:textSize="18sp"
                tools:text="77778888" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/summary_birth_date_label"
                android:textColor="@color/profile_secondary_text"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvSummaryBirthDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/profile_text"
                android:textSize="18sp"
                tools:text="12/05/2000" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/summary_address_label"
                android:textColor="@color/profile_secondary_text"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvSummaryAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/profile_text"
                android:textSize="18sp"
                tools:text="San Salvador, El Salvador" />
        </LinearLayout>

        <Button
            android:id="@+id/btnBackHome"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="32dp"
            android:backgroundTint="@color/profile_primary"
            android:text="@string/back_home_button"
            android:textAllCaps="false"
            android:textSize="16sp"
            app:cornerRadius="8dp" />

        <Button
            android:id="@+id/btnNewProfile"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:text="@string/new_profile_button"
            android:textAllCaps="false"
            android:textSize="16sp"
            app:cornerRadius="8dp" />
    </LinearLayout>
</ScrollView>
